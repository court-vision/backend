# Copy to .env and fill in values. Never commit .env.
# Lines use `export` so the file works both with `source .env` (needed because
# db/base.py reads DATABASE_URL from the process environment) and with
# pydantic-settings, which parses this file directly.

# --- Database (dev DB on Railway — never point local dev at production) ---
export DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Season / league defaults ---
export ESPN_YEAR=2027
export NBA_SEASON=2026-27
export ESPN_LEAGUE_ID=

# --- Clerk auth (https://dashboard.clerk.com) ---
export CLERK_JWKS_URL=https://<instance>.clerk.accounts.dev/.well-known/jwks.json
export CLERK_SECRET_KEY=sk_test_...
# Optional: JWT issuer override (defaults to the JWKS host)
# export CLERK_ISSUER=https://<instance>.clerk.accounts.dev
# Optional: allowed `azp` (frontend origins), JSON list. Empty disables the check.
# export CLERK_AUTHORIZED_PARTIES='["http://localhost:3000","https://www.courtvision.dev"]'

# --- Service-to-service ---
export PIPELINE_API_TOKEN=
export FEATURES_SERVER_ENDPOINT=http://localhost:8080

# --- Yahoo OAuth ---
export YAHOO_CLIENT_ID=
export YAHOO_CLIENT_SECRET=
export YAHOO_REDIRECT_URI=http://localhost:8000/v1/internal/yahoo/callback
export FRONTEND_URL=http://localhost:3000

# --- Optional integrations ---
# export BALLDONTLIE_API_KEY=
# export RESEND_API_KEY=
# export NOTIFICATION_FROM_EMAIL=alerts@courtvision.dev

# --- Logging ---
export LOG_LEVEL=INFO
export LOG_FORMAT=console
export DEVELOPMENT_MODE=true
